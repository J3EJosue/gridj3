---
import HojasDePuntos from '../components/HojasDePuntos';
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>Hojas de Puntos Personalizables</title>
		<style is:global>
			body {
				margin: 0;
				background: oklch(0.94 0.005 250);
				font-family: -apple-system, "Segoe UI", Helvetica, Arial, sans-serif;
			}
			a {
				color: oklch(0.5 0.12 250);
			}
			a:hover {
				color: oklch(0.4 0.14 250);
			}
			.settings-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 24px;
			}
			@media (max-width: 680px) {
				.settings-grid {
					grid-template-columns: 1fr;
				}
			}
			/* Below 680px the sheet and panel stack (mobile-friendly). At and
			   above it they always stay side by side — the sheet's own
			   width/height-fit scaling (computed in JS from previewOuterRef's
			   actual measured width) shrinks it to make room instead of the row
			   wrapping and pushing the panel down, e.g. when switching to a wider
			   landscape orientation. */
			.preview-row {
				flex-wrap: wrap;
			}
			@media (min-width: 680px) {
				.preview-row {
					flex-wrap: nowrap;
				}
			}
			.settings-panel input[type="range"] {
				accent-color: #2f6fed;
			}
			.settings-panel input[type="text"] {
				transition: border-color 0.15s ease, box-shadow 0.15s ease;
			}
			.settings-panel input[type="text"]:focus {
				outline: none;
				border-color: #2f6fed;
				box-shadow: 0 0 0 3px rgba(47, 111, 237, 0.15);
			}
			/* Hover-only on purpose: :focus-within/:focus-visible were dropped
			   because clicking the X badge (a real <button>) leaves it focused,
			   which kept these permanently visible until focus moved elsewhere
			   — looked "stuck on" instead of reacting to the actual mouse
			   position. The avatar's onClick still opens the file picker via
			   click or Enter/Space either way. */
			.logo-avatar-overlay {
				opacity: 0;
				transition: opacity 0.15s ease;
			}
			.logo-avatar:hover .logo-avatar-overlay {
				opacity: 1;
			}
			.logo-remove-badge {
				opacity: 0;
				transition: opacity 0.15s ease;
			}
			.logo-avatar:hover .logo-remove-badge {
				opacity: 1;
			}
			@keyframes spin {
				to { transform: rotate(360deg); }
			}
			.spin {
				animation: spin 0.8s linear infinite;
			}
			@media print {
				html, body {
					background: #fff !important;
				}
				.settings-panel {
					display: none !important;
				}
			}
		</style>
	</head>
	<body>
		<HojasDePuntos client:load />
	</body>
</html>
