---
import HojasDePuntos from '../components/HojasDePuntos';
import Analytics from '@vercel/analytics/astro';
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>Hojas de Puntos Personalizables</title>
		<meta name="description" content="Genera hojas de cuaderno personalizadas (puntos, líneas, cuadrícula, isométrico, caligrafía, pentagrama) con tu nombre y logo institucional, y descárgalas en PDF vectorial listo para imprimir." />
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://gridj3.vercel.app/" />
		<meta property="og:title" content="Hojas de Puntos Personalizables" />
		<meta property="og:description" content="Genera hojas de cuaderno personalizadas con tu nombre y logo institucional, y descárgalas en PDF listo para imprimir." />
		<meta property="og:image" content="https://gridj3.vercel.app/og-image.png" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Hojas de Puntos Personalizables" />
		<meta name="twitter:description" content="Genera hojas de cuaderno personalizadas con tu nombre y logo institucional, y descárgalas en PDF listo para imprimir." />
		<meta name="twitter:image" content="https://gridj3.vercel.app/og-image.png" />
		<style is:global>
			body {
				margin: 0;
				background: oklch(0.94 0.005 250);
				font-family: -apple-system, "Segoe UI", Helvetica, Arial, sans-serif;
			}
			a {
				color: oklch(0.5 0.12 250);
			}
			a:hover {
				color: oklch(0.4 0.14 250);
			}
			.settings-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 24px;
			}
			@media (max-width: 680px) {
				.settings-grid {
					grid-template-columns: 1fr;
				}
			}
			/* Below 680px the sheet and panel stack (mobile-friendly). At and
			   above it they always stay side by side — the sheet's own
			   width/height-fit scaling (computed in JS from previewOuterRef's
			   actual measured width) shrinks it to make room instead of the row
			   wrapping and pushing the panel down, e.g. when switching to a wider
			   landscape orientation. */
			.preview-row {
				flex-wrap: wrap;
			}
			@media (min-width: 680px) {
				.preview-row {
					flex-wrap: nowrap;
				}
			}
			/* Fixed so it never adds to the page's flow height — the sheet's
			   shrink-to-fit math (JS, keyed on viewport height) assumes nothing
			   else grows the page, and an in-flow footer broke that, causing a
			   scrollbar. Below 680px the panel stacks under the sheet and
			   already scrolls on its own, so a fixed corner pill there would
			   sit on top of scrolled-to controls (e.g. the size stepper) —
			   it drops back into normal flow, centered, at the very bottom. */
			.credit-footer {
				position: fixed;
				bottom: 10px;
				right: 12px;
				z-index: 5;
				display: flex;
				align-items: center;
				gap: 8px;
				white-space: nowrap;
				padding: 4px 10px;
				border-radius: 20px;
				background: rgba(255, 255, 255, 0.75);
				backdrop-filter: blur(4px);
				font-size: 10.5px;
				color: #9a9ea8;
			}
			.credit-footer a {
				color: #8a8e98;
			}
			@media (max-width: 680px) {
				.credit-footer {
					position: static;
					flex-direction: column;
					gap: 6px;
					margin: 0 auto;
					padding: 4px 16px 20px;
					background: none;
					backdrop-filter: none;
				}
			}
			.settings-panel input[type="range"] {
				accent-color: #2f6fed;
			}
			.settings-panel input[type="text"] {
				transition: border-color 0.15s ease, box-shadow 0.15s ease;
			}
			.settings-panel input[type="text"]:focus {
				outline: none;
				border-color: #2f6fed;
				box-shadow: 0 0 0 3px rgba(47, 111, 237, 0.15);
			}
			/* Always visible (not hover-gated): the X badge needs to be
			   reachable on touch devices too, which have no hover state — and
			   gating it behind hover made it disappear right after a click
			   left the button focused but the mouse elsewhere. */
			.logo-avatar-overlay,
			.logo-remove-badge {
				opacity: 1;
			}
			@keyframes spin {
				to { transform: rotate(360deg); }
			}
			.spin {
				animation: spin 0.8s linear infinite;
			}
			/* Ctrl+P direct printing, as a secondary path to "Descargar PDF" (the
			   legend text has always invited both). The @page rule matching the
			   current paper/orientation is injected dynamically by the component;
			   this resets the on-screen shrink-to-fit transform back to the
			   sheet's true physical size so what prints matches @page exactly. */
			@media print {
				html, body {
					background: #fff !important;
					margin: 0 !important;
					padding: 0 !important;
				}
				.settings-panel,
				.orientation-pill,
				.credit-footer {
					display: none !important;
				}
				.preview-row {
					padding: 0 !important;
					gap: 0 !important;
					justify-content: flex-start !important;
				}
				.sheet-outer {
					width: var(--page-w-px) !important;
				}
				.sheet-frame {
					width: var(--page-w-px) !important;
					height: var(--page-h-px) !important;
					overflow: visible !important;
					margin: 0 !important;
				}
				.page {
					transform: none !important;
					box-shadow: none !important;
					border-radius: 0 !important;
				}
			}
		</style>
	</head>
	<body>
		<HojasDePuntos client:load />
		<Analytics />
	</body>
</html>
